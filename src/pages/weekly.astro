---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PageHeader from "../components/features/page-header/PageHeader.astro";

const weeklyFiles = import.meta.glob("../content/weekly/*.json", { eager: true });

interface WeeklyEvent {
  id: string;
  title: string;
  impactScore: number;
  infoGainScore: number;
  summary: string;
}

interface WeeklyData {
  id: string;
  weekStart: string;
  weekEnd: string;
  events: WeeklyEvent[];
}

const weeks: { id: string; data: WeeklyData }[] = [];
for (const [path, mod] of Object.entries(weeklyFiles)) {
  const id = path.split("/").pop()?.replace(".json", "") || "";
  const data = (mod as any).default || mod;
  weeks.push({ id, data });
}
weeks.sort((a, b) => b.id.localeCompare(a.id));
---

<MainGridLayout>
  <PageHeader title="每周热点" subtitle="AI 驱动的热点事件深度梳理" />
  <div class="max-w-4xl mx-auto px-4 py-8">
    <p class="text-sm text-surface-50 mb-6">
      数据由 <a href="https://github.com/sixtdreanight/weekly-hotspot" target="_blank" rel="noopener" class="underline">weekly-hotspot</a> 自动生成，每周一更新
    </p>
    <div class="grid gap-8">
      {weeks.map(({ id, data }) => (
        <div class="p-6 rounded-lg border border-surface-20">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold">{id}</h2>
            <span class="text-sm text-surface-50">{data.weekStart} ~ {data.weekEnd}</span>
          </div>
          {data.events && data.events.length > 0 ? (
            <div class="grid gap-3">
              {data.events.map((event) => (
                <div class="p-4 rounded bg-surface-5">
                  <div class="flex items-center gap-3 mb-2">
                    <div class="flex gap-1">
                      <span class="text-xs px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300">影响 {event.impactScore}</span>
                      <span class="text-xs px-2 py-0.5 rounded bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300">增量 {event.infoGainScore}</span>
                    </div>
                    <span class="font-medium">{event.title}</span>
                  </div>
                  <p class="text-sm text-surface-50 leading-relaxed">{event.summary}</p>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-surface-50">暂无事件数据</p>
          )}
        </div>
      ))}
    </div>
    {weeks.length === 0 && (
      <p class="text-center text-surface-50 py-8">暂无周报数据</p>
    )}
  </div>
</MainGridLayout>
